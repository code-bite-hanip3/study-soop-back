// 공부의 숲 — Prisma 스키마 (보일러플레이트 뼈대)


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Study {
  id              String           @id @default(uuid())
  creatorNickname String
  name            String
  description     String?
  backgroundType  String           @default("COLOR")
  backgroundValue String?
  passwordHash    String
  pointTotal      Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  habits       Habit[]
  focusSessions FocusSession[]
  reactions    StudyReaction[]
  pointHistories PointHistory[]
}

model Habit {
  id        String   @id @default(uuid())
  studyId   String
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)  //해당 습관의 삭제 여부를 나타냄 true: 목록에 존재
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records HabitRecord[]
}

model HabitRecord {
  id          String   @id @default(uuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  dateKey     String // YYYY-MM-DD
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([habitId, dateKey])
}

model FocusSession {
  id                String    @id @default(uuid())
  studyId           String
  study             Study     @relation(fields: [studyId], references: [id], onDelete: Cascade)
  durationSeconds   Int
  accumulatedSeconds Int      @default(0)
  status            String    @default("READY") // READY/RUNNING/PAUSED/COMPLETED/CANCELLED
  lastResumedAt     DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  earnedPoint       Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  pointHistories PointHistory[]
}

model StudyReaction {
  id        String   @id @default(uuid())
  studyId   String
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  emoji     String // 실제 이모지 문자 (👍, 🔥, ❤️)
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studyId, emoji])
}

model PointHistory {
  id             String         @id @default(uuid())
  studyId        String
  study          Study          @relation(fields: [studyId], references: [id], onDelete: Cascade)
  focusSessionId String?
  focusSession   FocusSession?  @relation(fields: [focusSessionId], references: [id], onDelete: SetNull)
  amount         Int
  type           String // FOCUS_COMPLETED/BONUS/ADJUSTMENT
  createdAt      DateTime       @default(now())
}

